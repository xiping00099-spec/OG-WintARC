# Local use: copy this file to ".env" and fill it in. NEVER share it or upload it anywhere.
# On Render you type these into the "Environment" tab instead (see DEPLOY-RENDER.md).
BOT_TOKEN=123456789:replace-with-token-from-BotFather
ADMIN_IDS=123456789,987654321
WEB_ADMIN_PASSWORD=choose-a-long-password
WEB_SECRET=any-long-random-text
# Optional (on Render with a paid Disk: DB_PATH=/var/data/arc.db and BACKUP_DIR=/var/data/backups)
# DB_PATH=arc.db
# BACKUP_DIR=backups
# RUN_MODE=all
# PORT=8080
LOG_LEVEL=INFO

# Turso (external database - keeps data across Render restarts). Set BOTH or neither. See TURSO-SETUP.md
# TURSO_DATABASE_URL=libsql://winter-arc-yourname.turso.io
# TURSO_AUTH_TOKEN=paste-the-token-here
# Private Telegram group that receives off-site backups (see BACKUP-RESTORE.md)
# BACKUP_CHAT_ID=-1001234567890
# BACKUP_EVERY_HOURS=24
# BACKUP_KEEP_DAYS=30
